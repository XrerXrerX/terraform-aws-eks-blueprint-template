# Copy to backend.hcl (git-ignored) and fill in from `terraform -chdir=bootstrap output -raw backend_hcl`.
# Then: terraform init -backend-config=backend.hcl
#
# One state file per environment: change `key` (prod/..., staging/...).
bucket       = "my-org-myplatform-tfstate"
key          = "prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
kms_key_id   = "arn:aws:kms:us-east-1:111111111111:key/00000000-0000-0000-0000-000000000000"
use_lockfile = true
